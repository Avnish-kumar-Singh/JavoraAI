# ---------------- App runtime ----------------
APP_ENV=production
LOG_LEVEL=INFO

# ---------------- Ollama / LLM ----------------
OLLAMA_BASE_URL=http://localhost:11434
MODEL_NAME=qwen2.5:latest
EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_KEEP_ALIVE=30m
NUM_CTX=4096
LLM_TIMEOUT=180

# ---------------- RAG ----------------
CHROMA_PATH=./data/chroma_db
RETRIEVER_K=4
RETRIEVER_FETCH_K=8

# ---------------- Response sizing ----------------
SHORT_RESPONSE_TOKENS=600
MEDIUM_RESPONSE_TOKENS=1100
LONG_RESPONSE_TOKENS=1800

# ---------------- Cache ----------------
ENABLE_RESPONSE_CACHE=true
CACHE_MAX_ENTRIES=256
CACHE_TTL_SECONDS=3600

# ---------------- API / Auth ----------------
# Local default: SQLite. For docker-compose / AWS RDS, DATABASE_URL is built
# from the POSTGRES_* values below instead (see docker-compose.yml).
DATABASE_URL=sqlite:///./data/javamentor.db
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-strong-production-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ---------------- Postgres (used by docker-compose / AWS RDS) ----------------
POSTGRES_DB=javoraai
POSTGRES_USER=javora_admin
POSTGRES_PASSWORD=replace-with-a-strong-password

# ---------------- Deployment notes ----------------
# For AWS ECS/Fargate, set OLLAMA_BASE_URL to the reachable address of your
# Ollama service (a small dedicated instance, or a private endpoint).
